{
  "name": "huizhizuo-web",
  "version": "2.0.17",
  "description": "Huizhizuo desktop workbench",
  "author": "Huizhizuo",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "electron:dev": "concurrently -k \"vite --host 127.0.0.1 --port 5173\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "electron:pack": "pnpm run build && electron-builder --win --dir",
    "electron:dist": "pnpm run build && electron-builder --win nsis",
    "electron:portable": "pnpm run build && node electron/build-portable.cjs",
    "electron:prepare-portable": "node electron/build-portable.cjs --prepare-only",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test": "vitest run && node --test electron/main.node-test.cjs electron/build-portable.node-test.cjs"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.51.0",
    "antd": "^5.19.0",
    "lucide-react": "^1.27.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.25.0",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^10.0.4",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9.7.0",
    "typescript": "^5.5.3",
    "vite": "^5.3.4",
    "vitest": "^2.0.3",
    "wait-on": "^9.1.0"
  },
  "build": {
    "appId": "com.huizhizuo.image.desktop",
    "productName": "绘智作",
    "directories": {
      "output": "desktop-release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "icon": "public/brand/hz-logo.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
